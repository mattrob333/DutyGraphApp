# Copy to mobile/.env.local (ignored). Only EXPO_PUBLIC_* values reach the app
# bundle, and anything in the bundle is readable by users: never put secrets here.

# Backend selection: mock (default), dev-server, dutygraph-local, dutygraph-preview, dutygraph-production.\n# Legacy 'http' still works and keeps meeting extras opt-in (see README).
EXPO_PUBLIC_DATA_SOURCE=mock

# DutyGraph origin for 'http'. Local server: http://localhost:4417
# The dev server defaults to loopback; deliberate LAN testing requires HOST=0.0.0.0
# and your computer's reachable LAN origin here and in MEETINGS_API_BASE_URL.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4417

# 'questions' (default): Today and Me, question requests and task checks on the
# hands-free question cards. 'full': PR #48's app with Pulse, Meetings and Work.
EXPO_PUBLIC_COMPANION_SCOPE=questions

# Optional audio-only facilitator. Requires a native development build and provider-backed dev server.
EXPO_PUBLIC_FACILITATOR_REALTIME=false

# Only for legacy 'http'/dev-server mode: independent proposed meeting/voice development API.\n# Real DutyGraph profiles use EXPO_PUBLIC_API_BASE_URL for BOTH participant and meeting requests.
EXPO_PUBLIC_MEETINGS_API_BASE_URL=
