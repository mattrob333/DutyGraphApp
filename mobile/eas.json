{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DATA_SOURCE": "mock",
        "EXPO_PUBLIC_COMPANION_SCOPE": "full"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DATA_SOURCE": "mock",
        "EXPO_PUBLIC_COMPANION_SCOPE": "full"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DATA_SOURCE": "http",
        "EXPO_PUBLIC_API_BASE_URL": "https://dutygraph.com"
      }
    },
    "staging": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DATA_SOURCE": "http",
        "EXPO_PUBLIC_COMPANION_SCOPE": "full"
      },
      "environment": "preview"
    }
  },
  "submit": {
    "production": {}
  }
}
