{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DATA_SOURCE": "mock"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DATA_SOURCE": "mock"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DATA_SOURCE": "http",
        "EXPO_PUBLIC_API_BASE_URL": "https://dutygraph.com"
      }
    },
    "staging": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DATA_SOURCE": "http",
        "EXPO_PUBLIC_API_BASE_URL": "SET_ME_https_origin_reachable_from_phones"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
