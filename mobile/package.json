{
  "name": "dutygraph-companion",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.104.0",
    "expo": "~57.0.25",
    "expo-audio": "~57.0.5",
    "expo-battery": "~57.0.3",
    "expo-camera": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "^57.1.1",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webrtc": "^155.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "ajv": "8",
    "ajv-formats": "^3.0.1",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "typescript": "~6.0.3",
    "zod": "4.6.7"
  },
  "scripts": {
    "start": "expo start",
    "start:mock": "EXPO_PUBLIC_DATA_SOURCE=mock expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "verify": "npm run typecheck && npm run lint && npm test -- --ci",
    "contract:types": "npx --yes openapi-typescript@7 ../contracts/companion-mobile.openapi.json -o src/api/generated/companion-mobile-v1.ts",
    "doctor": "npx expo-doctor",
    "lint": "eslint src",
    "test:coverage:handsfree": "jest --runInBand --coverage --coverageDirectory=coverage/voice-handsfree --coverageReporters=json-summary --coverageReporters=text-summary --collectCoverageFrom='src/features/handsfree/**/*.{ts,tsx}' --collectCoverageFrom='src/features/meetings/**/*.{ts,tsx}' --collectCoverageFrom='!**/__tests__/**' --collectCoverageFrom='!**/__fixtures__/**' --coverageThreshold='{\"global\":{\"lines\":90}}' src/features/handsfree src/features/voice src/features/meetings",
    "test:e2e:http": "node scripts/e2e-http-suite.mjs",
    "contract:dutygraph": "node scripts/generate-dutygraph-contracts.mjs",
    "test:e2e:dutygraph": "node scripts/e2e-dutygraph-suite.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.after-env.ts"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "moduleNameMapper": {
      "^@shared/hands-free/(.*)$": "<rootDir>/../shared/hands-free/$1",
      "^zod$": "<rootDir>/node_modules/zod"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
