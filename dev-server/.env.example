# Documentation only: export these values in your shell. The server does not load dotenv.
PORT=4417
HOST=127.0.0.1
# Set HOST=0.0.0.0 only for deliberate fictional-data LAN testing.
# Leave DUTYGRAPH_ORIGIN unset for the fictional participant API.
# DUTYGRAPH_ORIGIN=https://your-dutygraph-origin.example
# Optional single-process fixture persistence; leave unset for fresh test runs.
# DEV_SERVER_DATA_FILE=.data/store.json
DEV_SERVER_AUDIO_DIR=.data/audio
FEATURE_AUTO_ADVANCE=false
FEATURE_FOLLOW_UPS=table
MEETING_BUDGET_CENTS_RECORD=200
MEETING_BUDGET_CENTS_LIVE=1500
# Real providers are opt-in. Keep credentials only in server secret management.
# OPENAI_API_KEY
# OPENAI_LIVE_TRANSCRIBE_API_KEY
# See docs/PORTING-TO-DUTYGRAPH.md for model overrides and provider details.
