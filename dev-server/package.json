{
  "name": "dutygraph-dev-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "env -u OPENAI_API_KEY -u OPENAI_LIVE_TRANSCRIBE_API_KEY tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "verify": "npm run typecheck && npm run lint && npm test",
    "coverage:check": "c8 --all --include 'src/**/*.ts' --reporter=text --reporter=json-summary --reporter=lcov --check-coverage --lines 90 --statements 0 --branches 0 --functions 0 npm test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "ws": "^8.18.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
